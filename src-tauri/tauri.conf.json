{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MinerDesk",
  "version": "0.7.22",
  "identifier": "com.minerdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MinerDesk",
        "width": 1480,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Desktop miner launcher and monitor",
    "longDescription": "MinerDesk launches, schedules and monitors multiple mining engines with desktop and headless web modes.",
    "copyright": "MinerDesk",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  }
}
